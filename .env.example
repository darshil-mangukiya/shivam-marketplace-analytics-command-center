# Optional Azure SQL / SQL Server warehouse connection settings.
# shared/sqlserver_loader.py reads these values for database loads.
#
# Copy this file to `.env` and fill in local values. `.env` is gitignored.

SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=shivam_marketplace_analytics
SQLSERVER_USERNAME=your_username_here
SQLSERVER_PASSWORD=your_password_here
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
